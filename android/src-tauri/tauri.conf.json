{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KAY LIVE SPORT",
  "version": "0.1.3",
  "identifier": "com.kaylivesport.mobile",
  "build": {
    "frontendDist": "../www",
    "beforeBuildCommand": "node prepare-ui.cjs",
    "beforeDevCommand": "node prepare-ui.cjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "KAY LIVE SPORT",
        "width": 412,
        "height": 860
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "android": {
      "minSdkVersion": 26
    }
  }
}